# ─────────────────────────────────────────────────────────────────────────────
# O SEGUNDO RUNTIME.
#
# Processo longo e estável não vive bem em função serverless — por isso o
# worker é um processo Node comum, com /healthz próprio, rodando numa VPS.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
WORKDIR /app
ENV NODE_ENV=production TZ=America/Sao_Paulo

# ── dependências ────────────────────────────────────────────────────────────
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts

# ── build ───────────────────────────────────────────────────────────────────
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json tsconfig.worker.json ./
COPY src ./src
RUN npx tsc -p tsconfig.worker.json

# ── runtime ─────────────────────────────────────────────────────────────────
FROM base AS runtime
RUN apk add --no-cache curl tini
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3001/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/workers/index.js"]
