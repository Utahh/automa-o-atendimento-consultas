# ─────────────────────────────────────────────────────────────────────────────
# O SEGUNDO RUNTIME.
#
# Processo longo e estável não vive bem em função serverless — por isso o
# worker é um processo Node comum, com /healthz próprio, rodando numa VPS.
# ─────────────────────────────────────────────────────────────────────────────
FROM node:22-alpine AS base
WORKDIR /app
ENV NODE_ENV=production TZ=America/Sao_Paulo

# ── dependências ────────────────────────────────────────────────────────────
# Com scripts: o esbuild baixa o proprio binario no postinstall, e sem ele o
# empacotamento do worker nao roda. No estagio de runtime, abaixo, os scripts
# continuam desligados — la nao se constroi nada.
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci

# ── build ───────────────────────────────────────────────────────────────────
# O worker e empacotado com esbuild, nao compilado com tsc: um arquivo so, com
# os aliases de caminho ja resolvidos e as dependencias deixadas de fora
# (elas vem do npm ci do estagio de runtime). tsc continua sendo quem verifica
# os tipos, no job de qualidade do CI.
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY src ./src
RUN npm run build:worker

# ── runtime ─────────────────────────────────────────────────────────────────
FROM base AS runtime
RUN apk add --no-cache curl tini
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3001/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/workers/index.js"]
