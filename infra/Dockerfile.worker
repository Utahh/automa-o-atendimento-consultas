# ─────────────────────────────────────────────────────────────────────────────
# O SEGUNDO RUNTIME.
#
# Processo longo e estável não vive bem em função serverless — por isso o
# worker é um processo Node comum, com /healthz próprio, rodando numa VPS.
# ─────────────────────────────────────────────────────────────────────────────
# NODE_ENV nao entra aqui: com production o `npm ci` omite as devDependencies,
# e e delas que sai o esbuild que empacota o worker. Ele so liga no runtime.
FROM node:26-alpine AS base
WORKDIR /app
ENV TZ=America/Sao_Paulo

# ── dependências ────────────────────────────────────────────────────────────
# Scripts desligados por padrao; so o esbuild e reconstruido, porque e no
# postinstall dele que o binario da plataforma aparece — e sem binario o
# empacotamento do worker nao roda.
FROM base AS deps
COPY package.json package-lock.json ./
RUN npm ci --ignore-scripts && npm rebuild esbuild

# ── build ───────────────────────────────────────────────────────────────────
# O worker e empacotado com esbuild, nao compilado com tsc: um arquivo so, com
# os aliases de caminho ja resolvidos e as dependencias deixadas de fora
# (elas vem do npm ci do estagio de runtime). tsc continua sendo quem verifica
# os tipos, no job de qualidade do CI.
FROM base AS build
COPY --from=deps /app/node_modules ./node_modules
COPY package.json tsconfig.json ./
COPY src ./src
RUN npm run build:worker

# ── runtime ─────────────────────────────────────────────────────────────────
FROM base AS runtime
ENV NODE_ENV=production
RUN apk add --no-cache curl tini
COPY package.json package-lock.json ./
RUN npm ci --omit=dev --ignore-scripts && npm cache clean --force
COPY --from=build /app/dist ./dist

USER node
EXPOSE 3001

HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -fsS http://127.0.0.1:3001/healthz || exit 1

ENTRYPOINT ["/sbin/tini", "--"]
CMD ["node", "dist/workers/index.js"]
