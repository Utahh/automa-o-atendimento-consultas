{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "module": "nodenext",
    "moduleResolution": "nodenext",
    "lib": ["ES2023"],
    "jsx": "react-jsx",
    "noEmit": false,
    "outDir": "dist",
    "rootDir": "src",
    "incremental": false,
    "plugins": []
  },
  "include": ["src/workers/**/*.ts", "src/shared/**/*.ts", "src/modules/**/*.ts"],
  "exclude": ["**/*.tsx", "**/*.test.ts", "node_modules", "dist", ".next"]
}
