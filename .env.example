# ---------------------------------------------------------------------------
# Kairo — variaveis de ambiente. Copie para .env e preencha.
# Nenhum segredo real entra no repositorio.
#
# Para chegar ao primeiro cliente pagante, a unica conta que existe e a VPS
# (US$ 5/mes). Todo o resto cabe em plano gratuito, e cabe com folga.
# ---------------------------------------------------------------------------

# --- Banco (Supabase Free ate 500 MB / 5 GB de egress) ---------------------
# Local: docker compose -f infra/docker-compose.dev.yml up -d
DATABASE_URL="postgres://kairo:kairo@localhost:55432/kairo"

# A fila usa o MESMO Postgres, em schema proprio — mas exige conexao em MODO
# SESSAO. Pooler em modo transacao (porta 6543, ou pgbouncer=true) faz o
# pg-boss parar de rodar SEM ERRO; o worker morre no boot se detectar isso.
FILA_DATABASE_URL="postgres://kairo:kairo@localhost:55432/kairo"

# --- Aplicacao -------------------------------------------------------------
APP_URL="http://localhost:3000"
TZ="America/Sao_Paulo"
# NAO defina NODE_ENV aqui: quem define e o comando. Um "development" fixo no
# .env faz o `next build` gerar um bundle inconsistente e quebrar o /404.

# Sessao — gere com: openssl rand -base64 32
SESSAO_SECRET=""

# --- Canal oficial de WhatsApp (Cloud API com Coexistence) -----------------
# Mensagem recebida e resposta dentro da janela de 24 h sao gratis.
# Template de utilidade fora da janela custa ~R$ 0,04-0,05.
CANAL_VERIFY_TOKEN=""
CANAL_APP_SECRET=""
CANAL_TOKEN=""
# Identificador do numero remetente na Graph API. No numero de teste gratuito
# da Meta ele aparece junto do token temporario, no painel do App.
CANAL_PHONE_NUMBER_ID=""
# Sem CANAL_TOKEN o gateway LOGA em vez de enviar: da para rodar o circuito
# inteiro sem conta na Meta e sem gastar centavo.
#
# O eco responde uma frase fixa a quem escrever. E andaime de teste, nao
# produto: fica desligado a menos que isto seja exatamente "true".
CANAL_ECO_ATIVO="false"

# --- IA --------------------------------------------------------------------
# O roteador deterministico corta 40-60% das chamadas antes de chegar aqui:
# e nele que se economiza, nao no provedor.
IA_API_KEY=""
IA_MODELO_PADRAO="claude-sonnet-5"
IA_MODELO_FALLBACK="claude-haiku-4-5-20251001"
# Teto de gasto diario por tenant, em centavos de dolar. Sem teto, um unico
# cliente em loop com o agente consome a margem do mes.
IA_TETO_DIARIO_TENANT_CENTAVOS="200"

# --- Worker ----------------------------------------------------------------
WORKER_PORT="3001"
WORKER_CONCORRENCIA="4"

# --- Opcionais, todos com plano gratuito -----------------------------------
# Resend: 3.000 e-mails/mes, 100/dia. E-mail e o canal GARANTIDO de todo
# escalonamento, porque push no iPhone so funciona com o app instalado.
RESEND_API_KEY=""

# Sentry Developer: 5 mil erros/mes, 1 usuario.
SENTRY_DSN=""

# PostHog: 1 M de eventos/mes. E conveniencia, nao infraestrutura — o nosso
# proprio event store ja responde quase tudo.
POSTHOG_KEY=""
