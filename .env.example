# ─────────────────────────────────────────────────────────────
# Kairo — variáveis de ambiente. Copie para .env e preencha.
# Nenhum segredo real entra no repositório.
# ─────────────────────────────────────────────────────────────

# Banco (Postgres). Local: docker compose -f infra/docker-compose.dev.yml up -d
DATABASE_URL="postgres://kairo:kairo@localhost:5432/kairo"

# Fila (pg-boss usa o mesmo Postgres, schema próprio)
FILA_DATABASE_URL="postgres://kairo:kairo@localhost:5432/kairo"

# Aplicação
APP_URL="http://localhost:3000"
NODE_ENV="development"
TZ="America/Sao_Paulo"

# Sessão — gere com: openssl rand -base64 32
SESSAO_SECRET=""

# Canal oficial de mensagens (webhook)
CANAL_VERIFY_TOKEN=""
CANAL_APP_SECRET=""
CANAL_TOKEN=""

# Provedor de IA
IA_API_KEY=""
IA_MODELO_PADRAO="claude-sonnet-5"
IA_MODELO_FALLBACK="claude-haiku-4-5-20251001"

# Worker
WORKER_PORT="3001"
WORKER_CONCORRENCIA="4"
