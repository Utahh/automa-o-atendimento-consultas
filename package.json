{
  "name": "kairo",
  "version": "0.1.0",
  "private": true,
  "description": "Kairo — agenda, atendimento e cobranca para profissionais de consulta.",
  "license": "SEE LICENSE IN LICENSE",
  "engines": {
    "node": ">=22.11 <25"
  },
  "packageManager": "npm@11.18.0",
  "scripts": {
    "dev": "next dev --turbopack",
    "dev:worker": "tsx watch src/workers/index.ts",
    "build": "next build",
    "start": "next start",
    "build:worker": "tsc -p tsconfig.worker.json",
    "start:worker": "node dist/workers/index.js",
    "lint": "eslint . --max-warnings 0",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:seed": "tsx src/shared/db/seed.ts",
    "verify": "npm run format:check && npm run lint && npm run lint:ui && npm run typecheck && npm run test",
    "prepare": "husky || true",
    "lint:ui": "node scripts/check-ui-rules.mjs"
  },
  "dependencies": {
    "date-fns": "^4.1.0",
    "date-fns-tz": "^3.2.0",
    "drizzle-orm": "^0.38.0",
    "next": "^15.1.0",
    "pg": "^8.13.0",
    "pg-boss": "^10.1.5",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.2.0",
    "@eslint/js": "^9.17.0",
    "@playwright/test": "^1.49.0",
    "@tailwindcss/postcss": "^4.0.0",
    "@types/node": "^22.10.0",
    "@types/pg": "^8.11.10",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "drizzle-kit": "^0.30.0",
    "eslint": "^9.17.0",
    "eslint-config-next": "^15.1.0",
    "eslint-plugin-boundaries": "^5.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.11",
    "prettier": "^3.4.2",
    "prettier-plugin-tailwindcss": "^0.6.9",
    "tailwindcss": "^4.0.0",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0",
    "vitest": "^2.1.8"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs,css,json,md,yml,yaml}": "prettier --write",
    "*.{ts,tsx}": "eslint --fix --max-warnings 0"
  }
}
